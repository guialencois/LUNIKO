# ============================================================
# PUBLIC — exposed to the browser bundle. Never put secrets here.
# ============================================================

# URL where the app itself is running (used for auth redirect links).
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anon (public) key.
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_.
# ============================================================

# Supabase service role key. NOT used by the app's own database access today
# — Drizzle connects directly via DATABASE_URL below, which already bypasses
# RLS on its own (a direct Postgres connection isn't subject to RLS; only
# access through Supabase's PostgREST/client libraries is). This key is
# reserved for future use if/when the app needs to call Supabase's own
# REST/Admin APIs server-side (e.g. Storage, Auth admin actions). Validated
# at startup for that reason, even though nothing reads it yet. Never sent
# to the browser. Get it from: Supabase Dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle. Supabase Dashboard > Project
# Settings > Database > Connection string (use the "Transaction" pooler
# connection string, port 6543, for serverless deployments).
#
# lib/db/index.ts passes `prepare: false` because transaction-mode pooling
# does not support prepared statements — see the comment there before
# changing either side.
DATABASE_URL=

# Shared secret the scheduler (Supabase Cron) sends as
# `Authorization: Bearer <secret>` when invoking the internal worker and
# reaper endpoints. Generate one: openssl rand -hex 32
#
# Those endpoints FAIL CLOSED: if this is unset, they refuse every request
# rather than running unauthenticated. Leaving it blank in local
# development is therefore safe — it just means the internal endpoints are
# turned off. See db/supabase/cron-jobs.sql for how the scheduler uses it.
CRON_SECRET=

# Symmetric key used later (Phase 6) to encrypt stored credentials.
# Generate one locally, e.g.: openssl rand -base64 32
# Must be at least 32 characters. Not used yet in Phase 1, but validated at
# startup so the env-schema stays accurate as soon as it's needed.
ENCRYPTION_KEY=
